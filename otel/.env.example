#### Mavvrik (required for all backends except multitenant) ####
# Find these in: Mavvrik Dashboard → Admin → Accounts → Agents
#                → +Agent (Setup → Connect → Register).
#
# MVK_API_KEY and MVK_TENANT_ID are sent on every outbound request to Mavvrik.
# MVK_AGENT_ID is a FALLBACK — the collector forwards X-Agent-ID from each
# incoming OTLP request when set, so one collector can serve a fleet of agents
# (each SDK identifies itself); MVK_AGENT_ID is used only when the SDK didn't
# send an X-Agent-ID header.
MVK_AGENT_ID=
MVK_API_KEY=
MVK_TENANT_ID=

#### Which collector config to load ####
# Default is ./config/otel-collector.mavvrik.yaml (Mavvrik + generic OTLP).
# Uncomment ONE of the following to switch backends:
# COLLECTOR_CONFIG=./config/otel-collector.datadog.yaml
# COLLECTOR_CONFIG=./config/otel-collector.grafana.yaml
# COLLECTOR_CONFIG=./config/otel-collector.multitenant.yaml

#### Generic OTLP backend ####
# Used by ./config/otel-collector.mavvrik.yaml and ./config/otel-collector.multitenant.yaml.
# THIRDPARTY_OTLP_ENDPOINT must be the base URL — the collector appends /v1/traces.
THIRDPARTY_OTLP_ENDPOINT=
THIRDPARTY_OTLP_AUTH=

#### Datadog ####
# Used by ./config/otel-collector.datadog.yaml.
# Available DD_SITE values:
#   datadoghq.com (US1, default) | us3.datadoghq.com | us5.datadoghq.com
#   datadoghq.eu (EU)            | ap1.datadoghq.com (Japan) | ap2.datadoghq.com (Australia)
#   ddog-gov.com (US1-FED)       | us2.ddog-gov.com (US2-FED)
# DD_API_KEY=
# DD_SITE=datadoghq.com

#### Grafana Cloud ####
# Used by ./config/otel-collector.grafana.yaml.
# Endpoint pattern: https://otlp-gateway-prod-<region>.grafana.net/otlp
#   Find your exact endpoint + Instance ID in:
#     Grafana Cloud Portal → your stack → OpenTelemetry tile → Configure
#   Create the API token in:
#     Grafana Cloud Portal → Security → Access Policies → Create access policy
#     with the `traces:write` scope → Add token
# GRAFANA_CLOUD_OTLP_ENDPOINT=
# GRAFANA_CLOUD_INSTANCE_ID=
# GRAFANA_CLOUD_API_KEY=

#### Collector's own log level ####
# debug | info | warn | error
LOG_LEVEL=info

#### Go runtime tuning ####
# Set GOMEMLIMIT to ~80% of your container's hard memory limit.
# This coordinates Go's GC with the memory_limiter processor so the container
# won't OOM under load. Per the OTel memory_limiter README, GOMEMLIMIT is
# strongly recommended on every production collector.
#   Examples: 1 GiB container → 820MiB | 2 GiB → 1638MiB | 4 GiB → 3276MiB
# GOMEMLIMIT=820MiB
